# App
APP_NAME=IntelliDesk
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=intellidesk

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama (local AI Support Assistant)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=45
CHAT_ASSISTANT_SYSTEM_PROMPT=You are IntelliDesk AI Support Assistant, an experienced IT HelpDesk Engineer. Answer only questions related to password reset, VPN, printer issues, Outlook, Microsoft Office, Windows, laptop problems, Wi-Fi, network, email, and software installation. If the question is outside IT support, politely respond with: "I can only assist with IT support questions."

# Database reset helper
RESET_DATABASE_CONFIRM=NO
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads/

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
